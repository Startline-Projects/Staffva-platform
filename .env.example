# ─────────────────────────────────────────────────────────────────────────────
# StaffVA platform — required environment
#
# Every variable below is READ BY THE CODE. The previous file documented only 9
# of these; the undocumented ones included CRON_SECRET, whose absence used to
# silently DISABLE the auth on every cron and webhook.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to SIGN the interview hand-off token (jose, HS256). The interview
# app verifies it with JWT_INTERVIEW_SECRET, so the two values must be
# byte-for-byte identical or "Start AI Interview" fails for every candidate.
# Note: rotating this in Supabase also breaks the hand-off until the interview
# app is updated in lockstep.
SUPABASE_JWT_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret for the main webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Separate signing secret for the Connect webhook endpoint (both post to
# /api/stripe/webhook, which tries each secret in turn)
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
# Candidate screening, matching, contract generation and recruiter scoring.
ANTHROPIC_API_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Contracts ───────────────────────────────────────────────────────────────
# HMAC secret for contract-signing links. There is no safe default: leaving
# this unset previously fell back to a value committed in the source, which
# made signing tokens forgeable.
CONTRACT_SIGNING_SECRET=

# ── Scheduled jobs & internal triggers ──────────────────────────────────────
# Shared secret for the Vercel crons and for internal server-to-server routes
# (candidate-emails, contracts/generate-pdf, escrow/auto-release).
# These checks now FAIL CLOSED: if this is unset those routes return 401 and
# the scheduled work silently stops running. It must be set in production.
CRON_SECRET=

# ── Google Calendar (recruiter booking sync) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_REDIRECT_URI=https://staffva.com/api/recruiter/google/callback

# ── Notifications ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── App URLs ────────────────────────────────────────────────────────────────
# Both are read in different places; set them to the same value to avoid
# checkout/redirect/email links pointing at the wrong host.
NEXT_PUBLIC_APP_URL=https://staffva.com
NEXT_PUBLIC_SITE_URL=https://staffva.com
